# Searchify x Tavily: Beispiel-Konfiguration. Kopieren nach `.env` und eigene Werte eintragen.
# Nur Platzhalter. `.env` steht in .gitignore und wird nie committet.

# --- Oeffentliches Web: Tavily Search API (https://tavily.com) ---
TAVILY_API_KEY=

# --- Antwortmodell: NVIDIA Nemotron ueber die Nebius Token Factory (OpenAI-kompatibel) ---
# Leer = Stub (Suchvarianten per Heuristik, Antwort extraktiv).
NEBIUS_API_KEY=
NEMOTRON_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Denkmodus von Nemotron 3 (1 = an). Aus ist schneller (Entwurf ~2 s statt ~11 s).
NEMOTRON_THINKING=0

# --- Private Quelle: Ordner mit md/txt/html/pdf. Leer = demo/intranet (fiktive Firma) ---
PRIVATE_DIR=

# --- Ranking ---
# l+nemotron (Standard): mMiniLM ueber alles, Llama-Nemotron-Rerank auf die Top 5
# l: nur mMiniLM | nemotron: nur Nemotron-Rerank | bm25: ohne Modell (leichte Rechner)
RESEARCH_RERANK=l+nemotron
RERANKER_MODEL=nvidia/llama-nemotron-rerank-1b-v2
RERANKER_REVISION=828765652b05bd439c9789d2a6d093db1caa1443
RERANKER_FORMAT=nemotron

# --- Eigene Websuche (nur fuer quellen=["web"] und die MCP-Tools search/read) ---
# ddgs (ohne Key) | searxng (self-host, deploy/docker-compose.yml) | serper (Key noetig)
SEARCH_BACKEND=ddgs
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=bitte-zufaelligen-wert-eintragen
SERPER_API_KEY=

# Prozesse fuer die Text-Extraktion. Klein halten auf Laptops.
EXTRACT_WORKERS=2
